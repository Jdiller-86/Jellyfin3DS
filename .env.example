# Copy to .env on the companion computer. Never copy this file to the SD card.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_USERNAME=your-user
JELLYFIN_PASSWORD=your-password
# Console IPv4; reserve it in your router for convenient reconnects.
DEVICE_IP=192.168.1.50
# Companion computer IPv4 reachable by the console (not 127.0.0.1).
COMPANION_IP=192.168.1.10
MEDIA_PORT=8742
